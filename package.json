{
  "name": "jetour-mongolia",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "translate": "python scripts/translate-en-mn.py",
    "spellcheck:mn": "python \"%USERPROFILE%/.claude/skills/mongolian-spellcheck/check_mn.py\"",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:generate:pg": "node scripts/prisma-pg.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:pg": "node scripts/prisma-pg.mjs && prisma db push --schema prisma/schema.postgres.prisma",
    "build:pg": "node scripts/prisma-pg.mjs && prisma generate --schema prisma/schema.postgres.prisma && next build && node scripts/copy-standalone-assets.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "db:export": "node scripts/db-export.mjs",
    "db:import": "node scripts/db-import.mjs",
    "db:verify": "node scripts/db-verify.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-toast": "^1.2.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
