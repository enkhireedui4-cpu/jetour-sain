# ============================================================
#  JETOUR Mongolia — орчны хувьсагчид
#  Энэ файлыг `.env` болгон хуулж, утгуудыг бөглөнө.
#  ЗААВАЛ / СОНГОХ гэсэн тэмдэглэгээг анхаарна уу.
# ============================================================

# ── Өгөгдлийн сан ───────────────────────────────────────────
# ЗААВАЛ. SQLite бол server.js-ээс ХАРЬЦАНГУЙ зам:
#   DATABASE_URL="file:../db/custom.db"
# Postgres руу шилжвэл (`npm run build:pg`):
#   DATABASE_URL="postgresql://хэрэглэгч:нууц@хост:5432/сан?schema=public"
DATABASE_URL="file:../db/custom.db"
# Зөвхөн Postgres + connection pooler (Supabase/Neon) үед:
DIRECT_URL=

# ── Домэйн ──────────────────────────────────────────────────
# ЗААВАЛ deploy-ийн өмнө. Sitemap, robots, canonical, OG зураг бүгд үүнээс
# үүснэ. Тохируулаагүй бол https://jetour.mn руу унана — домэйн өөр бол
# Google БУРУУ хаяг индекслэнэ.
NEXT_PUBLIC_SITE_URL=https://jetour.sainmotors.mn

# ── Админ нэвтрэлт (NextAuth) ───────────────────────────────
# ЗААВАЛ. NEXTAUTH_SECRET-г санамсаргүй үүсгэнэ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_USERNAME=
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
# Production дээр ЗААВАЛ — сайтын бүтэн хаяг
NEXTAUTH_URL=https://jetour.sainmotors.mn

# ── Лидийн мэдэгдэл (СОНГОХ, гэхдээ ЧУХАЛ) ──────────────────
# Тохируулаагүй бол лид зөвхөн өгөгдлийн санд хадгалагдаж, ХЭН Ч МЭДЭХГҮЙ.
# Тест драйвын хүсэлт ирээд хариугүй өнгөрөх эрсдэлтэй.
# Chat ID: bot-той чатаа эхлүүлээд
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates → chat.id

# Apps Script web app-ын URL болон түүнд тохируулсан нууц үг

# ── Хэмжилт (СОНГОХ) ────────────────────────────────────────
# GA4 — тохируулаагүй бол скрипт огт ачаалагдахгүй
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel — кодод анхдагч ID бий, дарж бичих үед л энд бичнэ
NEXT_PUBLIC_META_PIXEL_ID=

# Гадаад CRM (hub) руу лийд дамжуулах. Хоёуланг тохируулаагүй бол
# дамжуулалт чимээгүй өнгөрнө — DB-д хадгалалт үргэлж ажиллана.
HUB_LEAD_URL=
HUB_LEAD_TOKEN=
