# Local SQLite. Production uses PostgreSQL.
DATABASE_URL="file:../db/custom.db"
DIRECT_URL=

# Public canonical URL and authentication callback URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Local bcrypt hashes require escaped dollar signs. See docs/deployment.md.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional integrations.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
HUB_LEAD_URL=
HUB_LEAD_TOKEN=
CRON_SECRET=

# Shared across application instances. The proxy must overwrite the IP header.
RATE_LIMIT_SECRET=
TRUSTED_IP_HEADER=x-forwarded-for
